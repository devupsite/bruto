# ══════════════════════════════════════════════════════════════
# BRUTO — .htaccess (Hostinger / Apache-LiteSpeed)
# Conservador de propósito: cada bloco tem guard <IfModule>.
# ══════════════════════════════════════════════════════════════

# ── Página de erro 404 (o 404.html já existia, mas nunca era servido) ──
ErrorDocument 404 /404.html

# ── Redirecionamentos 301: páginas renomeadas/descontinuadas ──
# Evita 404 pra quem chega por link antigo, resultado de busca desatualizado
# ou favorito salvo. Achado via GA4: "Página não encontrada" com 60% de
# rejeição — provável origem em URLs indexadas antes das renomeações abaixo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^colecoes\.html$ /texturas.html [R=301,L]
  RewriteRule ^produto-cimenticio-grigio\.html$ /produto-cimenticio-brisa.html [R=301,L]
  RewriteRule ^produto-rockface-grigio\.html$ /produto-rockface-urban.html [R=301,L]
  RewriteRule ^produto-brick-branco-rose\.html$ /texturas.html [R=301,L]
  RewriteRule ^produto-brick-vulcano\.html$ /texturas.html [R=301,L]

  # Renomeação comercial 02/09/2026 (nomes inventados, código Faion mantido internamente)
  RewriteRule ^produto-brick-eco-palha\.html$ /produto-brick-zulko-claro.html [R=301,L]
  RewriteRule ^produto-brick-lumus\.html$ /produto-brick-nardek-rosado.html [R=301,L]
  RewriteRule ^produto-brick-mescla-prime\.html$ /produto-brick-vaskir-fundo.html [R=301,L]
  RewriteRule ^produto-brick-natura\.html$ /produto-brick-yandel-ambar.html [R=301,L]
  RewriteRule ^produto-brick-yandel-rosado\.html$ /produto-brick-yandel-ambar.html [R=301,L]
  RewriteRule ^produto-brick-rosso-prime\.html$ /produto-brick-kelvar-aceso.html [R=301,L]
  RewriteRule ^produto-brick-rusticatto-fume\.html$ /produto-brick-thavrin-cinza.html [R=301,L]
  RewriteRule ^produto-brick-rusticatto-palha\.html$ /produto-brick-ostrek-claro.html [R=301,L]
  RewriteRule ^produto-brick-rusticatto-rosso\.html$ /produto-brick-vanrik-rosso.html [R=301,L]
  RewriteRule ^produto-brick-rusticatto-sertao\.html$ /produto-brick-kharun-funda.html [R=301,L]
  RewriteRule ^produto-brick-rusticatto-terra-negra\.html$ /produto-brick-ulvren-negro.html [R=301,L]
  RewriteRule ^produto-brick-terra-cerrado\.html$ /produto-brick-zendral-cobre.html [R=301,L]
  RewriteRule ^produto-cimenticio-alpino\.html$ /produto-cimenticio-naevel-claro.html [R=301,L]
  RewriteRule ^produto-cimenticio-brisa\.html$ /produto-cimenticio-sorvel-leve.html [R=301,L]
  RewriteRule ^produto-cimenticio-urban\.html$ /produto-cimenticio-thurgo-denso.html [R=301,L]
  RewriteRule ^produto-rockface-alpino\.html$ /produto-rockface-kelthar-branco.html [R=301,L]
  RewriteRule ^produto-rockface-brisa\.html$ /produto-rockface-yavrin-ameno.html [R=301,L]
  RewriteRule ^produto-rockface-urban\.html$ /produto-rockface-rundak-bruto.html [R=301,L]
</IfModule>

# ── Forçar HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── Headers de segurança básicos ──
# (sem CSP de propósito: o site usa inline scripts + GTM + CDNs,
#  uma CSP mal calibrada quebraria tudo silenciosamente)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Cache do navegador ──
# HTML sempre revalida (mudança no site aparece na hora).
# CSS/JS usam cache-busting ?v=N (COLABORACAO.md item 11) — 7 dias é o
# meio-termo: cache real, mas um bump esquecido se corrige sozinho em 1 semana.
# Imagens raramente mudam de conteúdo sob o mesmo nome — 30 dias.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compressão (se o servidor ainda não fizer) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
